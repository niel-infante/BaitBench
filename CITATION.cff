    family-names: Cross
    orcid: "https://orcid.org/0000-0003-0846-1488"
    affiliation: University of Nebraska Medical Center
repository-code: "https://github.com/niel-infante/BaitBench"
license: MIT
version: 1.0.0
date-released: "2026-10-02"
keywords:
  - hybrid capture
  - target enrichment
  - probe design
  - bait design
  - simulation
  - metagenomics
  - bioinformatics

