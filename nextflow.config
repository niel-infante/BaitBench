/*
 * BaitBench Pipeline Configuration
 */

// Default parameters
params {
    // Required inputs (must be specified on command line or params file)
    targets = null
    distractors = null
    probes = null

    // Optional inputs
    host_fasta = null           // Host genome for filtering (null = skip)
    run_name = null             // Auto-generated if not specified

    // Simulation parameters
    num_reads = 10000           // Number of reads to simulate
    distractor_fraction = 0.9   // Fraction of reads from distractors (0-1)
    seed = null                 // Random seed (null = random)

    // Capture parameters
    capture_method = 'minimap2' // 'minimap2' or 'blast'
    max_mismatches = 10         // Max mismatches for minimap2 capture
    min_match_bases = 60        // Min matching bases required

    // BLAST parameters (if capture_method == 'blast')
    blast_db_dir = './blast_db' // Directory containing BLAST databases

    // Minimap2 parameters
    minimap_preset = 'sr'       // Preset for read mapping
    host_minimap_preset = 'sr'  // Preset for host filtering

    // Output
    outdir = './results'
}


// Process resource defaults
process {
    cpus = 1
    memory = '4 GB'
    time = '1h'

    withName: 'FILTER_HOST' {
        cpus = 4
        memory = '8 GB'
    }

    withName: 'MAP_READS' {
        cpus = 4
        memory = '8 GB'
    }

    withName: 'BLAST_CAPTURE' {
        cpus = 4
        memory = '8 GB'
        time = '3h'
    }
}


// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'standard'
        process.clusterOptions = '--account=default'
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        // process.container = 'baitbench:latest'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        // process.container = 'baitbench.sif'
    }

    test {
        params.num_reads = 1000
        params.distractor_fraction = 0.5
    }
}


// Reporting
report {
    enabled = true
    file = "${params.outdir}/pipeline_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_trace.txt"
}


// Manifest
manifest {
    name = 'BaitBench'
    author = 'Your Name'
    description = 'Probe capture efficiency testing pipeline'
    version = '0.1.0'
    nextflowVersion = '>=21.04.0'
    mainScript = 'main.nf'
}
